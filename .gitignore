.env
.env.*
!.env.example
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/
.DS_Store
# generated site data is committed only by the bot from Actions; local renders are ignored
# site/data/*.json are committed by the bot (small, derived from processed parquet)
!site/data/.gitkeep
# duckdb scratch files
*.duckdb
*.duckdb.wal
# generated html
site/*.html
site/.nojekyll

# macOS / sync-agent duplicate copies ("name 2.ext") must never enter the repo
* [0-9].*
